# Local demonstration only. Copy to .env to override Compose defaults.
APP_PORT=8080
DATABASE_PASSWORD=local-demo-database
DEMO_OPERATOR_PASSWORD=operator-demo
DEMO_CUSTOMER_PASSWORD=customer-demo
DOWNLOAD_LINK_TTL=PT5M
FRAUD_ENABLED=true
STATEMENTS_ENABLED=true
# Each source publishes a new transaction every five seconds by default.
# Set 0 for seed-only mode (used by deterministic acceptance tests).
EMIT_INTERVAL_MS=5000
# Shared only by the demo app and the three private source control endpoints.
# Use the same value (at least 24 characters) for all four services.
MOCK_CONTROL_KEY=local-demo-source-control-key-2026
